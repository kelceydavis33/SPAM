  "bulk_help": {
    "title": "Using the \u2193 ALL buttons",
    "intro": "Each \u2193 ALL button saves a list of URLs to a text file for download management.",
    "steps": [
      {
        "text": "Click \u2193 ALL at the top of the column you want. This downloads a text file: spam_nrc_sci_urls.txt for the science mosaics, spam_nrc_err_urls.txt for the error maps, and spam_nrc_wht_urls.txt for the weight maps.",
        "command": ""
      },
      {
        "text": "Place the text file in the directory where you would like to download the data. In your terminal, run:",
        "command": "wget -c -i spam_nrc_sci_urls.txt"
      },
      {
        "text": "On macOS, use curl instead and run:",
        "command": "xargs -n1 curl -OC- < spam_nrc_sci_urls.txt"
      }
    ],
    "footnote": ""
  },
  "products": {
    "sci": "Science mosaic",
    "err": "Error map",
    "wht": "Weight map"
  },
